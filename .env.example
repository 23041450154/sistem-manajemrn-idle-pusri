# ============================================================================
# Frontend Idle Equipment (Next.js 16) — contoh environment
# Topologi dev: SATU host har.pusri.dev — FE di /idle (basePath), BE di /idle/air.
# NEXT_PUBLIC_* di-inline saat BUILD (ganti nilai -> WAJIB rebuild).
# ============================================================================

# --- Base URL backend (Gin) ---
# config/api.ts menerima NEXT_PUBLIC_API_URL ATAU API_URL. Server pakai ini utk
# fetch /auth/me, /auth/logout, dsb. BE ada di /idle/air.
#
# DEV LOKAL (tanpa reverse proxy): rewrite next.config mem-proxy /idle/air/*
# ke BE lokal. Jalankan `go run .` (port 8080) lalu set:
API_URL=http://127.0.0.1:8080
#
# PROD: /idle/air ditangkap reverse proxy SEBELUM sampai ke Next — rewrite
# tidak pernah aktif. Ganti ke:
# API_URL=https://har.pusri.dev/idle/air
# (opsional, kalau butuh dibaca di client component / images.remotePatterns)
# NEXT_PUBLIC_API_URL=https://har.pusri.dev/idle/air

# --- Service SSO gateway ---
# Tombol "Masuk dengan SSO": {NEXT_PUBLIC_API_SSO}/api/login?client_id=...
NEXT_PUBLIC_API_SSO=https://gwkong.pusri.dev/sso-dev

# client_id aplikasi (didaftarkan tim SSO). Dev idle-equipment:
NEXT_PUBLIC_CLIENT_ID=idle-equipment-development

# --- Path prefix reverse proxy ---
# FE di-serve di /idle. WAJIB di-set saat BUILD.
NEXT_PUBLIC_BASE_URL=/idle

# ----------------------------------------------------------------------------
# LEGACY — dipakai halaman logout lama (Keycloak end-session manual). Alur baru
# logout lewat backend {BE}/api/logout, jadi dua var ini TIDAK lagi diperlukan.
# NEXT_PUBLIC_SSO_OIDC_BASE_URL=https://accounts.pusri.dev
# NEXT_PUBLIC_SSO_REALM=dev_apps

# --- Login form dev (NPP/password) ---
# true = /login menampilkan form NPP/password (login dev lokal via
# POST /api/auth/login; backend juga harus LOGIN_PASSWORD_MODE di-set).
# JANGAN di-set saat build produksi — /login prod adalah SSO-only.
NEXT_PUBLIC_LOGIN_FORM=
