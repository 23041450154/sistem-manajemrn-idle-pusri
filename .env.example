# ============================================================================
# Frontend Idle Equipment (Next.js 16) — contoh environment
# Salin ke .env (atau .env.local), isi nilai nyata per environment.
# Variabel NEXT_PUBLIC_* di-inline ke bundle saat BUILD.
# ============================================================================

# --- Base URL backend (Gin) ---
# GANTI ke host BE dev kalian di .pusri.dev.
NEXT_PUBLIC_API_URL=https://idle-api.pusri.dev

# --- Service SSO (gateway Pusri) ---
# Dipakai tombol "Masuk dengan SSO": {NEXT_PUBLIC_API_SSO}/api/login?client_id=...
#   Development       : https://gwkong.pusri.dev/sso-dev
#   Production co.id   : https://gwkong.pusri.co.id/sso
#   Production .id     : https://gwkong.pusri.id/sso
NEXT_PUBLIC_API_SSO=https://gwkong.pusri.dev/sso-dev

# client_id aplikasi (didaftarkan ke tim SSO, BEDA per environment).
#   local: pusri-id-local | dev: pusri-id-dev | prod: pusri-id-prod
NEXT_PUBLIC_CLIENT_ID=pusri-id-dev

# --- Reverse proxy path prefix (opsional) ---
# Kosong = di-serve dari root. Isi mis. "/idle" bila di belakang path prefix.
# WAJIB di-set saat BUILD bila dipakai.
NEXT_PUBLIC_BASE_URL=
